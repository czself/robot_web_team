# 复制为 .env.local，再填写自己的配置；本文件只提供空白模板。

# 生产环境必须配置持久化 KV；本地 npm run dev 可使用临时内存存储。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 首次登录时初始化管理员。用户名为 6–20 位数字学号；
# 密码为 6–72 位，必须同时包含字母和数字。留空则不初始化。
TEAM_ADMIN_USERNAME=
TEAM_ADMIN_PASSWORD=

# 招新与留言邮件通知；未配置时跳过邮件发送。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# 临时内存存储开关。生产部署应保留 false 并配置上方 KV。
ALLOW_IN_MEMORY_KV=false
